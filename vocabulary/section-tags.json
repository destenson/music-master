  "transition_tags": [
    {
      "id": "tt_hard_cut",
      "label": "hard cut",
      "signature": "step_any",
      "description": "No fill, no sweep. One section stops and the next starts."
    },
    {
      "id": "tt_drum_fill",
      "label": "drum fill",
      "signature": "fill",
      "description": "The outgoing section's last bar is filled, which is the commonest transition in rock."
    },
    {
      "id": "tt_fill",
      "label": "instrumental fill",
      "signature": "fill",
      "description": "A short lead or keyboard fill carries the join."
    },
    {
      "id": "tt_riser",
      "label": "riser",
      "signature": "riser",
      "description": "A rising noise or synth sweep into the next section."
    },
    {
      "id": "tt_reverse_cymbal",
      "label": "reverse cymbal",
      "signature": "riser",
      "description": "A reversed cymbal swelling into the downbeat."
    },
    {
      "id": "tt_downlifter",
      "label": "downlifter",
      "signature": "downlifter",
      "description": "A falling sweep, usually into a breakdown or a verse."
    },
    {
      "id": "tt_build",
      "label": "build-up",
      "signature": "build",
      "description": "Density and intensity rising across the join rather than at it."
    },
    {
      "id": "tt_stop",
      "label": "stop",
      "signature": "gap",
      "description": "Everything stops for a beat before the next section lands. The oldest trick there is."
    },
    {
      "id": "tt_break",
      "label": "break",
      "signature": "gap",
      "description": "A short gap with a single element left ringing."
    },
    {
      "id": "tt_silence",
      "label": "dead silence",
      "signature": "gap",
      "description": "A deliberate silence between sections."
    },
    {
      "id": "tt_filter_open",
      "label": "filter opening",
      "signature": "sweep_up",
      "description": "A low-pass filter opens across the join, brightening the mix."
    },
    {
      "id": "tt_filter_close",
      "label": "filter closing",
      "signature": "sweep_down",
      "description": "A filter closes, darkening into the next section."
    },
    {
      "id": "tt_drop",
      "label": "drop-in",
      "signature": "step_up",
      "description": "Full arrangement arrives on the downbeat, much louder than what preceded it."
    },
    {
      "id": "tt_gang_entry",
      "label": "gang vocal entry",
      "signature": "step_up",
      "description": "The next section opens with voices rather than instruments."
    },
    {
      "id": "tt_smooth",
      "label": "smooth",
      "signature": "smooth",
      "description": "No boundary event; the sections run into each other."
    },
    {
      "id": "tt_crossfade",
      "label": "crossfade",
      "signature": "smooth",
      "description": "The outgoing element decays while the incoming one grows."
    },
    {
      "id": "tt_hold",
      "label": "held note",
      "signature": "smooth",
      "description": "A sustained note or chord bridges the two sections."
    },
    {
      "id": "tt_pickup",
      "label": "early pickup",
      "signature": "anticipation",
      "description": "The next section starts a beat or two early, pushing across the bar line."
    },
    {
      "id": "tt_count_in",
      "label": "count-in",
      "signature": "fill",
      "description": "A counted or clicked entry, usually from a stop."
    }
  ],
