  "consistency": [
    {
      "id": "instruments_match_instrumental_tags",
      "caption_bins": [
        "drums",
        "bass",
        "harmony",
        "synth",
        "extra_instrument"
      ],
      "section_pool": "instrumental_section_tags",
      "rule": "An instrument named as a solo or interlude in the lyrics should be present in the caption's instrumentation, and vice versa. The model does not resolve conflicts; it degrades."
    },
    {
      "id": "emotion_matches_energy_tags",
      "caption_bins": [
        "mood",
        "energy"
      ],
      "section_pool": "energy_tags",
      "rule": "Energy and emotion tags in the lyrics must not contradict the caption's mood or energy selections."
    },
    {
      "id": "vocal_matches_vocal_tags",
      "caption_bins": [
        "lead_vocal",
        "vocal_delivery",
        "backing_vocal"
      ],
      "section_pool": "vocal_tags",
      "rule": "Vocal control tags in the lyrics must be consistent with the caption's vocal, delivery and backing selections."
    },
    {
      "id": "no_vocals_no_vocal_tags",
      "caption_bins": [
        "lead_vocal"
      ],
      "section_pool": "vocal_tags",
      "rule": "When the lead vocal bin is Instrumental or No Vocals, no vocal control tag may appear in the lyrics."
    }
  ]
