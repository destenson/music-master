__pycache__/
*.pyc

# Generated run outputs. Renders, measurements and per-seed prompt records are produced by
# songs/<song>/build_and_submit.py and the analyse_*.py scripts. They are regenerated rather than
# stored: the renders live in ComfyUI's output directory, and a take is reproducible from its seed.
songs/*/take_*.mp3
songs/*/audio.mp3
songs/*/prompt_s*.json
songs/*/report.json
songs/*/section_analysis.json
songs/*/*_analysis_s*.json
songs/*/*_analysis_take*.json
songs/*/.numba/

spikes/*.result.json
spikes/*.wav
spikes/.numba/
spikes/preview-8s/
spikes/tag-atlas/
spikes/genre-atlas/
spikes/batch-validation/
artifacts/
.venv/

# Node. The Pyodide spike installs its runtime here, and the SPA build will install here too.
node_modules/
.npm-cache/
spikes/pyodide_text_core/*.log

# The browser-oracle spike keeps its model cache and its own Chromium inside the workspace, so
# neither has to be written to a shared cache directory. Both are re-downloadable.
spikes/browser_oracle/.cache/
spikes/browser_oracle/.pw-browsers/

# The SPA build. `web/dist` is generated by `npm run build`, and carries a copy of the repository
# and of the Pyodide runtime; neither belongs in version control.
web/dist/
previews/
